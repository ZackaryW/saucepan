{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"], "strict": true, "exactOptionalPropertyTypes": true,
    "declaration": true, "outDir": "dist", "rootDir": "src",
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
